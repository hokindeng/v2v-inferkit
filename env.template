# Copy to .env and fill in. Loaded automatically by run.py via python-dotenv.
# Each model needs only its own keys — leave the rest empty.

# Runway Aleph (runway-aleph-v2v)
RUNWAYML_API_SECRET=

# Kling Omni (kling-v2-6-v2v). Either the direct API key...
KLING_API_KEY=
# ...or the JWT pair:
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Luma Ray 3.2 video_edit (luma-ray-3.2-v2v)
LUMA_AGENTS_API_KEY=

# fal.ai CDN — needed by Kling and Luma to host the input video
FAL_KEY=

# WaveSpeed — wan-2.7-video-edit and gemini-omni-flash-video-edit
WAVESPEED_API_KEY=

# --- Open-source models (local GPU) ---

# HuggingFace token — needed for gated checkpoints: nvidia/Cosmos3-Super,
# google/gemma-3-12b-it-qat-q4_0-unquantized (LTX-2.3 text encoder),
# black-forest-labs/FLUX.1-Redux-dev (HY-OmniWeaving siglip component).
# Accept each repo's license on huggingface.co first.
HF_TOKEN=

# Where model checkpoints live (default: <repo>/weights). Point at an
# existing download directory (e.g. /home/ubuntu/models) to reuse it.
V2V_WEIGHTS_DIR=

# Multi-GPU models: GPUs to use (cosmos3-super-v2v, magi-24b-v2v)
COSMOS_NUM_GPUS=4
MAGI_NUM_GPUS=4
