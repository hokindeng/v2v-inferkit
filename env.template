# Copy to .env and fill in. Loaded automatically by run.py via python-dotenv.
# Each model needs only its own keys — leave the rest empty.

# Runway Aleph (runway-aleph-v2v)
RUNWAYML_API_SECRET=

# Kling Omni (kling-v2-6-v2v). Either the direct API key...
KLING_API_KEY=
# ...or the JWT pair:
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Luma Ray 3.2 video_edit (luma-ray-3.2-v2v)
LUMA_AGENTS_API_KEY=

# fal.ai CDN — needed by Kling and Luma to host the input video
FAL_KEY=

# WaveSpeed — wan-2.7-video-edit and gemini-omni-flash-video-edit
WAVESPEED_API_KEY=
