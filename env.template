# Copy to .env and fill in. Loaded automatically by run.py via python-dotenv.
# One FAL_KEY runs every fal-hosted model. Runway is the only commercial
# exception because fal.ai does not expose the Aleph endpoint.

# Runway Aleph (runway-aleph-v2v)
RUNWAYML_API_SECRET=

# fal.ai inference and input upload for all other commercial models
FAL_KEY=

# --- Local/open-weight models (local GPU) ---

# HuggingFace token — needed for gated checkpoints: nvidia/Cosmos3-Super,
# google/gemma-3-12b-it-qat-q4_0-unquantized (LTX-2.3 text encoder),
# black-forest-labs/FLUX.1-Redux-dev (HY-OmniWeaving siglip component).
# Accept each repo's license on huggingface.co first.
HF_TOKEN=

# Where model checkpoints live (default: <repo>/weights). Point at an
# existing download directory (e.g. /home/ubuntu/models) to reuse it.
V2V_WEIGHTS_DIR=
# Override the interpreter used to create model venvs. Bernini requires 3.11
# and uses BERNINI_PYTHON (default python3.11) separately.
MODEL_PYTHON=
BERNINI_PYTHON=python3.11

# Multi-GPU models: GPUs to use (cosmos3-super-v2v, magi-24b-v2v)
COSMOS_NUM_GPUS=4
MAGI_NUM_GPUS=4

# Optional local path overrides. Empty values use <repo>/repos and
# V2V_WEIGHTS_DIR defaults installed by setup/install_model.sh.
BERNINI_REPO_PATH=
BERNINI_WEIGHTS_PATH=
KIWI_WEIGHTS_PATH=
EDITTO_REPO_PATH=
EDITTO_WEIGHTS_PATH=
EDITTO_LORA_PATH=
SAMA_REPO_PATH=
SAMA_BASE_MODEL_PATH=
SAMA_WEIGHTS_PATH=
SAMA_CHECKPOINT=
OMNIVIDEO2_REPO_PATH=
OMNIVIDEO2_WEIGHTS_PATH=
OMNIVIDEO2_QWEN_PATH=
COINVE_REPO_PATH=
COINVE_BASE_MODELS_PATH=
COINVE_WEIGHTS_PATH=
COINVE_CHECKPOINT=
COINVE_QWEN_PATH=
LUCY_WEIGHTS_PATH=

# JoyAI defaults to an automatically managed localhost server. Set this to a
# preloaded external service only when it was launched with --record-dir.
JOYAI_SERVER_URL=
JOYAI_REPO_PATH=
JOYAI_WEIGHTS_PATH=
JOYAI_TEXT_ENCODER_PATH=
# For a BF16-only joyomni_ops build, set both values to 0.
JOYOMNI_FP8_IMG=1
JOYOMNI_FP8_TXT=1
# Recommended for GPUs with <=48GB VRAM.
JOYOMNI_LOW_VRAM=1
